#!/usr/bin/env bash
set -euo pipefail

# ============================================================
# seqfetcher — Unified sequencing data fetcher
# ============================================================

VERSION="1.1.0"

# -------------------------------
# Directories
# -------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/lib"

# -------------------------------
# Source libraries (safe)
# -------------------------------
shopt -s nullglob
for lib in "$LIB_DIR"/*.sh; do
    source "$lib"
done
shopt -u nullglob

# -------------------------------
# Defaults
# -------------------------------
THREADS=4
OUTPUT_DIR="downloads"
MAX_RETRIES=3
DRY_RUN=false
VERBOSE=true
ENSEMBL_TYPE="ensembl"
ENSEMBL_RELEASE=""

# -------------------------------
# Global help
# -------------------------------
show_help() {
    cat <<EOF
seqfetcher v$VERSION

Usage:
  seqfetcher <command> <subcommand> [options] [args]

Commands:
  discover assembly           Search assemblies
  download genome             Download genome
  download transcriptome      Download transcriptome
  download proteome           Download proteome
  download fastq              Download FASTQ from SRA
  convert geo-to-srr          Convert GEO accession to SRR list
  check                       Check environment

Global options:
  --outdir DIR
  --threads N
  --max-retries N
  --ensembl-type TYPE
  --ensembl-release N
  --dry-run
  --verbose
  -h, --help
  -v, --version

Run:
  seqfetcher <command> --help
  seqfetcher <command> <subcommand> --help
for detailed help.
EOF
}

# -------------------------------
# Global option parser
# -------------------------------
parse_global_options() {

    COMMAND=""
    SUBCOMMAND=""
    GLOBAL_ARGS=()

    local POSITIONAL=()

    # First pass: separate flags and positionals
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --outdir|--threads|--max-retries|--ensembl-type|--ensembl-release)
                [[ -n "${2:-}" ]] || { log_error "$1 requires a value"; exit 1; }
                case "$1" in
                    --outdir)           OUTPUT_DIR="$2" ;;
                    --threads)          THREADS="$2" ;;
                    --max-retries)      MAX_RETRIES="$2" ;;
                    --ensembl-type)     ENSEMBL_TYPE="$2" ;;
                    --ensembl-release)  ENSEMBL_RELEASE="$2" ;;
                esac
                shift 2
                ;;
            --dry-run)
                DRY_RUN=true
                shift
                ;;
            --verbose)
                VERBOSE=true
                shift
                ;;
            --help|-h)
                POSITIONAL+=("$1")
                shift
                ;;
            *)
                POSITIONAL+=("$1")
                shift
                ;;
        esac
    done

    # Extract command + subcommand from positionals
    COMMAND="${POSITIONAL[0]:-}"
    SUBCOMMAND="${POSITIONAL[1]:-}"

    # Remaining are subcommand arguments
    GLOBAL_ARGS=("${POSITIONAL[@]:2}")
}

# -------------------------------
# Cleanup trap (safe)
# -------------------------------
cleanup() { :; }
trap cleanup EXIT

# -------------------------------
# Main
# -------------------------------
main() {

    # Top-level fast paths
    case "${1:-}" in
        --help|-h|help)
            show_help
            exit 0
            ;;
        --version|-v|version)
            echo "seqfetcher v$VERSION"
            exit 0
            ;;
        check)
            check_environment
            exit $?
            ;;
    esac

    # Parse globals + detect contextual help
    parse_global_options "$@"

    log_debug "Parsed: COMMAND=$COMMAND SUBCOMMAND=$SUBCOMMAND ARGS=${GLOBAL_ARGS[*]}"

    # Require at least a command
    if [[ -z "$COMMAND" ]]; then
        show_help
        exit 1
    fi

    create_dirs

    case "$COMMAND:$SUBCOMMAND" in

        discover:)
            cmd_discover_assembly "${GLOBAL_ARGS[@]}"
            ;;

        download:genome)
            cmd_download_genome "${GLOBAL_ARGS[@]}"
            ;;
        download:transcriptome)
            cmd_download_transcriptome "${GLOBAL_ARGS[@]}"
            ;;
        download:proteome)
            cmd_download_proteome "${GLOBAL_ARGS[@]}"
            ;;
        download:fastq)
            cmd_download_fastq "${GLOBAL_ARGS[@]}"
            ;;

        convert:geo-to-srr)
            cmd_convert_geo "${GLOBAL_ARGS[@]}"
            ;;

        convert:)
            log_error "Missing subcommand for 'convert'"
            show_subcommand_help "convert:geo-to-srr"
            exit 1
            ;;

        *)
            log_error "Unknown command: $COMMAND ${SUBCOMMAND:-}"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
